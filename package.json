{
  "name": "tapd-server-cli",
  "version": "0.2.2",
  "description": "TAPD MCP Server — expose TAPD Open API as MCP tools, with one-command install for Claude Code / Codex / OpenCode / Cursor.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "tapd-server-cli": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "release": "node scripts/publish.mjs",
    "release:dry": "node scripts/publish.mjs --dry-run",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "@inquirer/checkbox": "^5.2.0",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "commander": "^12.1.0",
    "p-limit": "^6.1.0",
    "pino": "^9.5.0",
    "undici": "^7.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "eslint": "^9.17.0",
    "eslint-plugin-import": "^2.31.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "keywords": [
    "tapd",
    "mcp",
    "model-context-protocol",
    "claude",
    "claude-code",
    "codex",
    "opencode",
    "cursor",
    "tencent",
    "agile"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wanggan768q/tapd-server-cli.git"
  },
  "homepage": "https://github.com/wanggan768q/tapd-server-cli#readme",
  "bugs": {
    "url": "https://github.com/wanggan768q/tapd-server-cli/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
