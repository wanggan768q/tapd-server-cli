# ============================================================================
# TAPD MCP Server — 环境变量示例
# 复制为 .env 后填写真实值。切勿提交 .env 到 git。
# ============================================================================

# [必需] TAPD 个人访问令牌（personal access token）
TAPD_TOKEN=

# [可选] TAPD API 基地址（默认 https://api.tapd.cn；私有部署时覆盖）
# TAPD_API_BASE=https://api.tapd.cn

# [可选] 全局并发上限（默认 8）
# TAPD_CONCURRENCY=8

# [可选] 单请求超时，毫秒（默认 30000）
# TAPD_TIMEOUT_MS=30000

# [可选] 日志级别 trace / debug / info / warn / error（默认 info）
# TAPD_LOG_LEVEL=info

# [可选] 权限探针缓存 TTL，秒（默认 600）
# TAPD_PERMISSION_TTL_SEC=600

# [可选] 启用 MCP streamable HTTP 传输并监听该端口；未设置则只走 stdio
# TAPD_MCP_HTTP_PORT=8787

# ===== Web Cookie 模式（可选，用于附件下载） =====
# 当 PAT 缺少 attachments::get_attachment_download_url scope 时，可借用浏览器登录态：
# 浏览器到 https://www.tapd.cn → F12 → Application → Cookies → 复制全部 cookie 字符串
# 形如 t_i_token=...; tapd_user=...; PHPSESSID=... （直接整段填入）
# 警告：cookie 等同凭据，切勿提交到 git；过期需重新提取
# TAPD_WEB_COOKIE=

# [可选] 网页基地址（默认 https://www.tapd.cn）
# TAPD_WEB_BASE=https://www.tapd.cn

# [可选] 网页客户端独立并发上限（默认 4）
# TAPD_WEB_CONCURRENCY=4
